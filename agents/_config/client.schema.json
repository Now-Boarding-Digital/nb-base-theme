{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://styleguidehero.local/agents/_config/client.schema.json",
  "title": "styleguidehero client profile",
  "type": "object",
  "required": ["id", "displayName", "figma"],
  "properties": {
    "id": { "type": "string", "description": "Stable slug (kebab-case), matches client-quirks/{id}.md" },
    "displayName": { "type": "string" },
    "role": { "type": "string", "description": "e.g. design_partner, end_client" },
    "figma": {
      "type": "object",
      "required": ["fileKey", "fileUrl"],
      "properties": {
        "fileKey": { "type": "string", "description": "Figma file key from the design URL" },
        "fileUrl": { "type": "string", "format": "uri" },
        "fileLabel": { "type": "string" },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string", "pattern": "^[0-9]+:[0-9]+$" }, { "type": "null" }]
          },
          "description": "Node ids for MCP (use colon form: 123:456). Null = not set yet."
        }
      }
    },
    "notes": { "type": "string" }
  }
}
